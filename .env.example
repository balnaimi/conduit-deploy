# ─────────────────────────────────────────────
# Conduit Matrix Server - Environment Variables
# Copy to .env and edit before starting
# ─────────────────────────────────────────────

# Your domain name (MUST have DNS pointing to this VPS)
SERVER_NAME=matrix.example.com

# Registration token (users need this to register)
# Generate with: openssl rand -hex 32
REGISTRATION_TOKEN=CHANGE_ME

# TURN shared secret (for voice/video calls)
# Generate with: openssl rand -hex 32
TURN_SECRET=CHANGE_ME
